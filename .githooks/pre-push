#!/usr/bin/env bash

# Prevent direct pushes to main from local machines
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "❌ ERROR: Direct push to 'main' is prohibited from local machines."
    echo "👉 Please push your changes to 'dev' (or a feature branch targeting 'dev')."
    echo "   The CI staging pipeline automatically fast-forwards 'main' once all tests pass."
    exit 1
  fi
done

exit 0
