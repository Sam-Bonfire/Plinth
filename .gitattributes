# Auto-detect text files and normalize line endings to LF on checkout and commit
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.hurl text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.md text eol=lf

# Binary files (prevent line-ending alterations and corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wasm binary