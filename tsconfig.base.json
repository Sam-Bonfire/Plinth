{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@plinth/ui-kit": ["packages/ui-kit/src"],
      "@plinth/sync-protocol": ["packages/sync-protocol/src"],
      "@plinth/core-domain": ["packages/core-domain/src"]
    },
    "jsx": "react-jsx"
  }
}
