{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@plinth/ui-kit": ["../../packages/ui-kit/src"],
      "@plinth/ui-kit/*": ["../../packages/ui-kit/src/*"],
      "@plinth/sync-protocol": ["../../packages/sync-protocol/src"],
      "@plinth/sync-protocol/*": ["../../packages/sync-protocol/src/*"],
      "@plinth/core-domain": ["../../packages/core-domain/src"],
      "@plinth/core-domain/*": ["../../packages/core-domain/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
