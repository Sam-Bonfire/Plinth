{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@plinth/ui-kit": ["../../packages/ui-kit/src"],
      "@plinth/ui-kit/*": ["../../packages/ui-kit/src/*"],
      "@plinth/sync-protocol": ["../../packages/sync-protocol/src"],
      "@plinth/sync-protocol/*": ["../../packages/sync-protocol/src/*"],
      "@plinth/core-domain": ["../../packages/core-domain/src"],
      "@plinth/core-domain/*": ["../../packages/core-domain/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
